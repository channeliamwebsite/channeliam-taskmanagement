# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API.

# Public: safe to expose to the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only: bypasses RLS. Never prefix with NEXT_PUBLIC_ and never commit.
# Only needed once server-side admin operations (user management) are built.
SUPABASE_SERVICE_ROLE_KEY=
