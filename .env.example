# Copy to .env.local and fill in from Supabase Dashboard -> Project Settings -> API.

# Public: safe to expose to the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only: bypasses RLS. Never prefix with NEXT_PUBLIC_ and never commit.
# Only needed once server-side admin operations (user management) are built.
SUPABASE_SERVICE_ROLE_KEY=

# Server only: the app's public address, used for links in invitation and
# password-reset emails. Production: https://taskmanager.likesandshares.com
# (required on Vercel; email links are never built from the browser address).
APP_URL=http://localhost:3000

# Server only: Resend API key for leave-notification emails (new request /
# approved / rejected). Separate from Supabase Auth's own SMTP (invite/reset
# emails), which is configured in the Supabase Dashboard, not here. Uses the
# same Resend account and verified channeliam.com domain.
RESEND_API_KEY=
# Sender address; must be on the verified Resend domain.
EMAIL_FROM=team@channeliam.com
# Recipients for "new leave request" notifications.
LEAVE_NOTIFY_TO=team@channeliam.com
LEAVE_NOTIFY_CC=ceo@channeliam.com
